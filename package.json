{
  "name": "zxrsa-store",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "db:migration:create": "wrangler d1 migrations create zxrsa-store-db",
    "db:migrate:local": "wrangler d1 migrations apply zxrsa-store-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply zxrsa-store-db --remote",
    "db:seed:local": "wrangler d1 execute zxrsa-store-db --local --file=./server/database/seed.sql",
    "db:seed:prod": "wrangler d1 execute zxrsa-store-db --remote --file=./server/database/seed.sql",
    "deploy": "nuxt build && wrangler deploy"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/simple-icons": "^1.2.100",
    "@nuxt/ui": "^4.12.0",
    "@vue-email/components": "^0.0.21",
    "@vue-email/render": "^0.0.9",
    "@vueuse/core": "^15.0.0",
    "nuxt": "^4.6.2",
    "nuxt-auth-utils": "^0.6.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.13.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "nitro-cloudflare-dev": "^0.2.2",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.156.0"
  },
  "packageManager": "pnpm@12.15.0"
}
